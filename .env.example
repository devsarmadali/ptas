# Local and test values only. Never commit real credentials.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://ptas:ptas@localhost:5432/ptas
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ptas-local
OBJECT_STORAGE_ACCESS_KEY=local-only
OBJECT_STORAGE_SECRET_KEY=local-only
AUTH_SECRET=replace-with-local-random-value
LOG_LEVEL=info
ENABLE_MOCK_PAYMENTS=true
ENABLE_MOCK_IDENTITY=true

# Supabase (Managed PostgreSQL, Auth, and S3 Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-server-actions
